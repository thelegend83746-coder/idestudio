<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.idestudio.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".IDEStudioApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IDEStudio"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Home Project Management Screen -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- New Project Configuration Screen -->
        <activity
            android:name=".ui.create.ConfigureProjectActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- Edit Project Screen (App Icon, Name, Package, Min/Target SDK) -->
        <activity
            android:name=".ui.create.EditProjectActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- Code Editor Screen -->
        <activity
            android:name=".ui.editor.EditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI Chat Activity -->
        <activity
            android:name=".ui.ai.AIChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings Screen -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- FileProvider for Sharing Exported Backups -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.idestudio.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
