<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.IDEStudio" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_indigo</item>
        <item name="colorPrimaryDark">@color/primary_indigo_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Rounded Card Style -->
    <style name="Widget.IDEStudio.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@color/bg_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Dialog Style -->
    <style name="Theme.IDEStudio.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.IDEStudio.MediumComponent</item>
    </style>

    <style name="ShapeAppearance.IDEStudio.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>
</resources>
