<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_edit_project"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:title="Edit Project"
        app:titleTextColor="#212121"
        app:navigationIcon="?android:attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- App Icon Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Application Icon"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />

                    <ImageView
                        android:id="@+id/img_edit_app_icon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@mipmap/ic_launcher"
                        android:scaleType="fitCenter"
                        android:background="@drawable/bg_icon_frame"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/tv_edit_icon_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default Launcher Icon"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_edit_pick_gallery"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Gallery"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_button_primary"
                            android:layout_marginEnd="8dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                        <Button
                            android:id="@+id/btn_edit_pick_preset"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Presets"
                            android:textSize="12sp"
                            android:textColor="#1976D2"
                            android:background="@drawable/bg_button_secondary"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Basic Details Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App Details"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />

                    <!-- App Name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Application Name"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_edit_app_name"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="My Android App"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textCapWords"
                        android:singleLine="true"
                        android:layout_marginBottom="14dp" />

                    <!-- Package Name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Package Name (applicationId)"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_edit_package_name"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="com.example.myapp"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:inputType="textUri"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tv_edit_package_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#D32F2F"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SDK Configuration Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SDK Configuration"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />

                    <!-- Min SDK -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Minimum SDK"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:id="@+id/btn_edit_min_sdk"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/tv_edit_min_sdk_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="API 21: Android 5.0 (Lollipop)"
                            android:textSize="14sp"
                            android:textColor="#212121" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textSize="10sp"
                            android:textColor="#757575" />
                    </LinearLayout>

                    <!-- Target SDK -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Target SDK"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:id="@+id/btn_edit_target_sdk"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_edit_target_sdk_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="API 34: Android 14"
                            android:textSize="14sp"
                            android:textColor="#212121" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼"
                            android:textSize="10sp"
                            android:textColor="#757575" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Project Path Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Project Location"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_edit_project_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="/storage/emulated/0/test-folder/ide-studio/projects/..."
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:fontFamily="monospace" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_edit_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="#616161"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_edit_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="Save Changes"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>

</LinearLayout>
