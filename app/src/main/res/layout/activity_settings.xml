<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_settings"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:title="AI &amp; System Settings"
        app:titleTextColor="#212121"
        app:navigationIcon="?android:attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Workspace Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Workspace Location"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_settings_workspace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="/storage/emulated/0/idestudio"
                        android:textSize="13sp"
                        android:textColor="#1976D2"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="All projects and backups are stored inside this folder."
                        android:textSize="11sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- AI Configuration Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ollama / Cloud AI Configuration"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp" />

                    <!-- Quick Preset Buttons -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quick Presets:"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <Button
                            android:id="@+id/btn_preset_local"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Local"
                            android:textSize="11sp"
                            android:background="@drawable/bg_button_secondary"
                            android:textColor="#212121"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_preset_groq"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Groq"
                            android:textSize="11sp"
                            android:background="@drawable/bg_button_secondary"
                            android:textColor="#212121"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btn_preset_openrouter"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="OpenRouter"
                            android:textSize="11sp"
                            android:background="@drawable/bg_button_secondary"
                            android:textColor="#212121" />

                    </LinearLayout>

                    <!-- Base URL -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="API Base URL (e.g. http://localhost:11434 or https://...)"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_settings_base_url"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="http://localhost:11434"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:layout_marginBottom="14dp" />

                    <!-- API Key -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Real API Key (Ollama Cloud / Groq / OpenRouter / OpenAI)"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_settings_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Paste your API key here (e.g. gsk_... or sk-...)"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:layout_marginBottom="14dp" />

                    <!-- Model Name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Model Name (e.g. llama3, mistral, llama-3.1-70b-versatile)"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_settings_model"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="llama3"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:layout_marginBottom="16dp" />

                    <!-- Test Connection Button -->
                    <Button
                        android:id="@+id/btn_settings_test_conn"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="Test API Connection"
                        android:textSize="13sp"
                        android:textColor="#1976D2"
                        android:background="@drawable/bg_button_secondary"
                        android:layout_marginBottom="8dp" />

                    <!-- Test Status Result -->
                    <TextView
                        android:id="@+id/tv_settings_test_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:visibility="gone"
                        android:padding="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_settings_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Settings"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary" />

    </LinearLayout>

</LinearLayout>
