<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_folder_actions_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:text="Folder Actions"
        android:textColor="@color/text_navy_dark"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 1. Rename -->
    <TextView
        android:id="@+id/action_folder_rename"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Rename Folder"
        android:textColor="@color/text_navy_dark"
        android:textSize="15sp" />

    <!-- 2. Create File -->
    <TextView
        android:id="@+id/action_folder_create_file"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Create File"
        android:textColor="@color/primary_indigo"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 3. Create Folder -->
    <TextView
        android:id="@+id/action_folder_create_folder"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Create Folder"
        android:textColor="@color/primary_indigo"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="@color/bg_card_stroke" />

    <!-- 4. Delete -->
    <TextView
        android:id="@+id/action_folder_delete"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Delete Folder"
        android:textColor="@color/status_error"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
