<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_build_status_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_check_circle_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_build_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Build Successful"
                android:textColor="@color/text_navy_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_build_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed in 320 ms"
                android:textColor="@color/text_grey_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_build"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Error Summary Card (Visible on failure) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_build_error_summary"
        style="@style/Widget.IDEStudio.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FEF2F2"
        app:strokeColor="#FCA5A5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_error_file_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/status_error"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_navy_dark"
                android:textSize="13sp" />

            <!-- Error Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_error"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Copy Error"
                    android:textColor="@color/primary_indigo"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_copy"
                    app:iconSize="14dp"
                    app:strokeColor="@color/primary_indigo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_in_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/primary_indigo"
                    android:text="Fix with Build AI"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Terminal Console Logs -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="Build Log"
        android:textColor="@color/text_navy_dark"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="#0F172A"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_build_console_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.2"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />
    </ScrollView>

    <!-- Bottom Actions: Close, Retry, Copy (Install removed as requested) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_build"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Close"
            android:textColor="@color/text_grey_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_build"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Retry"
            android:textColor="@color/primary_indigo"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary_indigo" />

        <!-- Copy Log Button Added in place of Install -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_build_log"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary_indigo"
            android:text="Copy"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_copy"
            app:iconTint="@color/text_white" />
    </LinearLayout>

</LinearLayout>
