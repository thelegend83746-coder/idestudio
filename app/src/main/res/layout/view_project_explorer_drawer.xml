<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:background="@color/bg_card"
    android:clickable="true"
    android:elevation="16dp"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Drawer Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_drawer_project_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Project Explorer"
            android:textColor="@color/text_navy_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Files &amp; Folders (Swipe left to close)"
            android:textColor="@color/text_grey_blue"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_card_stroke" />

    <!-- File Tree List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_file_tree"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

</LinearLayout>
