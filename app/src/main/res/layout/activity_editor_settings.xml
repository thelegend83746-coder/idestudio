<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121218"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E2E"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Editor Settings"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Kinetic Physics & Overscroll -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Physics &amp; Scrolling Dynamics"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cb_overscroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Kinetic fling friction &amp; rubber-band bounce back"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="Provides high-inertia smooth kinetic fling and rubber-band spring recovery when pulled past boundaries."
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <!-- Font Size -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Font Size (sp)"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_font_size"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_rounded"
                android:inputType="number"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="14"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Tab Size -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tab Size (Spaces)"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_tab_size"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_rounded"
                android:inputType="number"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Line Numbers -->
            <CheckBox
                android:id="@+id/cb_line_numbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:checked="true"
                android:text="Show line numbers"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Word Wrap -->
            <CheckBox
                android:id="@+id/cb_word_wrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="false"
                android:text="Word wrap (Soft wrap)"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/btn_save_editor_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_save"
                android:text="Save Settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
