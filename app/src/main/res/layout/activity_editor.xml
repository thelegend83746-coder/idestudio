<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_editor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E">

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Pro Editor Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#252526"
            app:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <!-- ☰ Drawer Menu Icon -->
                <ImageButton
                    android:id="@+id/btn_drawer_toggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Open Project Explorer"
                    android:src="@drawable/ic_menu"
                    app:tint="#D4D4D4" />

                <!-- Project & Active File Title -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_toolbar_project_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_toolbar_file_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:textColor="#858585"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Search / Find in file -->
                <ImageButton
                    android:id="@+id/btn_action_search"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#D4D4D4" />

                <!-- Undo Action -->
                <ImageButton
                    android:id="@+id/btn_action_undo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Undo"
                    android:src="@drawable/ic_undo"
                    app:tint="#D4D4D4" />

                <!-- Redo Action -->
                <ImageButton
                    android:id="@+id/btn_action_redo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Redo"
                    android:src="@drawable/ic_redo"
                    app:tint="#D4D4D4" />

                <!-- Save Action -->
                <ImageButton
                    android:id="@+id/btn_action_save"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Save File"
                    android:src="@drawable/ic_save"
                    app:tint="#4CAF50" />

                <!-- AI Coding Assistant -->
                <ImageButton
                    android:id="@+id/btn_action_ai"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="AI Assistant"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#2196F3" />

                <!-- Overflow Menu -->
                <ImageButton
                    android:id="@+id/btn_action_overflow"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More Options"
                    android:src="@drawable/ic_more_vert"
                    app:tint="#D4D4D4" />

            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Find & Replace Toolbar (Collapsible) -->
        <LinearLayout
            android:id="@+id/layout_search_replace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2D2D2D"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <!-- Search Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_search_query"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Find in file..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#757575"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tv_search_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"
                    android:paddingHorizontal="6dp" />

                <ImageButton
                    android:id="@+id/btn_search_prev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/arrow_up_float"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btn_search_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btn_search_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#E57373" />
            </LinearLayout>

            <!-- Replace Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_replace_query"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Replace with..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#757575"
                    android:textSize="12sp"
                    android:paddingHorizontal="8dp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_search_replace"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Replace"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_secondary"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="8dp" />

                <Button
                    android:id="@+id/btn_search_replace_all"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="All"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_secondary"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Editor Tabs Bar -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_editor_tabs"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#252526"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333" />

        <!-- Zoom Floating Badge Indicator -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Code Editor Scrolling Area -->
            <ScrollView
                android:id="@+id/scroll_vertical_editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1E1E1E"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Line Numbers Gutter -->
                    <TextView
                        android:id="@+id/tv_line_numbers"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="#1E1E1E"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:lineSpacingMultiplier="1.2"
                        android:minWidth="42dp"
                        android:paddingHorizontal="8dp"
                        android:paddingTop="12dp"
                        android:text="1\n2\n3"
                        android:textColor="#5A5A5A"
                        android:textSize="13sp" />

                    <!-- Gutter Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#333333" />

                    <!-- Horizontal Scroll for Code -->
                    <HorizontalScrollView
                        android:id="@+id/scroll_horizontal_editor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <EditText
                            android:id="@+id/et_code_editor"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:fontFamily="monospace"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textNoSuggestions"
                            android:lineSpacingMultiplier="1.2"
                            android:minWidth="800dp"
                            android:padding="12dp"
                            android:textColor="#D4D4D4"
                            android:textSize="13sp" />
                    </HorizontalScrollView>

                </LinearLayout>
            </ScrollView>

            <!-- Zoom Level Badge (Pinch-to-zoom feedback) -->
            <TextView
                android:id="@+id/tv_zoom_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_dialog_rounded"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="13sp (100%)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Empty Editor Placeholder -->
            <TextView
                android:id="@+id/tv_empty_editor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No file open\nSelect a file from the Project Explorer (☰)"
                android:textAlignment="center"
                android:textColor="#757575"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Pro Mobile Programming Shortcut Bar -->
        <HorizontalScrollView
            android:id="@+id/scroll_symbols_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#252526"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_symbols_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <!-- Symbol Chips dynamically populated or styled buttons -->
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333" />

        <!-- Pro Status Bar at Bottom -->
        <LinearLayout
            android:id="@+id/layout_status_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="#007ACC"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/tv_status_cursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ln 1, Col 1"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_status_lines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 lines"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_status_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13sp"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_status_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Java"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Project Explorer Drawer (Start / Left) -->
    <include
        layout="@layout/view_project_explorer_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
