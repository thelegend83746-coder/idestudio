<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content Frame -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top Toolbar (56dp) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/surface_light"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <!-- Hamburger / Drawer Toggle -->
                <ImageView
                    android:id="@+id/btn_drawer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="@color/text_primary_light" />

                <!-- Project Title -->
                <TextView
                    android:id="@+id/tv_project_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="idestudio"
                    android:textColor="@color/text_primary_light"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Undo Button ↶ -->
                <TextView
                    android:id="@+id/btn_undo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="↶"
                    android:textColor="@color/text_primary_light"
                    android:textSize="22sp" />

                <!-- Redo Button ↷ -->
                <TextView
                    android:id="@+id/btn_redo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="↷"
                    android:textColor="@color/text_primary_light"
                    android:textSize="22sp" />

                <!-- Folder Icon 📁 -->
                <ImageView
                    android:id="@+id/btn_folder"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="@color/text_primary_light" />

                <!-- Green Run Pill Button -->
                <TextView
                    android:id="@+id/btn_run"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_pill_run"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="@string/run"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Three-Dots Menu ⋮ -->
                <ImageView
                    android:id="@+id/btn_more"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_more"
                    app:tint="@color/text_primary_light" />

            </LinearLayout>

            <!-- Tabs Bar (40dp) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@color/surface_light"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/tv_active_tab"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="MAINACTIVITY.JAVA"
                        android:textColor="@color/active_tab_red"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/active_tab_red" />

            <!-- Code Editor Canvas with Smooth Scrolling & Overscroll -->
            <com.ide.studio.view.SmoothCodeEditor
                android:id="@+id/code_editor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp"
                android:scrollbars="vertical|horizontal" />

            <!-- Symbol & Autocomplete Accessory Bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_light" />

            <HorizontalScrollView
                android:id="@+id/scroll_symbol_bar"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@color/surface_light"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_symbol_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp" />
            </HorizontalScrollView>

        </LinearLayout>

        <!-- Floating "Save File" Pill Button -->
        <LinearLayout
            android:id="@+id/pill_save_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_pill_save"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_idestudio_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/save_file"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer (Left File Tree) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_drawer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Project Files"
                android:textColor="@color/text_primary_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_file_tree"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
