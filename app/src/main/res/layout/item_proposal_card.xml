<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.IDEStudio.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:strokeColor="@color/bg_card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Operation Type & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_proposal_operation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="#EEF2FF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Update File"
                android:textColor="@color/primary_indigo"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_proposal_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending Approval"
                android:textColor="@color/status_warning"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Target Path -->
        <TextView
            android:id="@+id/tv_proposal_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="app/src/main/java/com/example/MainActivity.java"
            android:textColor="@color/text_navy_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Code / Content Preview -->
        <ScrollView
            android:id="@+id/scroll_proposal_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#F8FAFC"
            android:maxHeight="160dp"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_proposal_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text_navy_dark"
                android:textSize="12sp" />
        </ScrollView>

        <!-- Approval Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_approval_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reject_proposal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Reject"
                android:textColor="@color/status_error"
                android:textSize="13sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/status_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_approve_proposal"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/status_success"
                android:text="Approve"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
